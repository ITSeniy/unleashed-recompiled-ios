+#if TARGET_OS_IPHONE
+    struct MetalSpatialState {
+        NS::SharedPtr<MTLFX::SpatialScaler> scaler;
+        NS::SharedPtr<MTL::Device> device;
+        uint32_t inputWidth = 0, inputHeight = 0, outputWidth = 0, outputHeight = 0;
+        RenderFormat format = RenderFormat::UNKNOWN;
+    };
+
+    // Preparation also occurs during initial device setup; encoding runs on the render thread.
+    // Keep an old scaler alive
+    // through completion even if a later frame replaces its cached descriptor.
+    static std::shared_ptr<MetalSpatialState> &metalSpatialState() {
+        static std::shared_ptr<MetalSpatialState> state;
+        return state;
+    }
+
+    static std::mutex &metalSpatialMutex() { static std::mutex mutex; return mutex; }
+
+    void setMetalPassDiagnosticLabel(RenderCommandList *renderList, const char *label) {
+        auto *list = static_cast<MetalCommandList *>(renderList);
+        if (list->passDiagnostics) list->passDiagnostics->pendingLabel = label;
+    }
+
+    bool prepareMetalSpatialUpscaling(RenderDevice *renderDevice, uint32_t inputWidth, uint32_t inputHeight,
+        uint32_t outputWidth, uint32_t outputHeight, RenderFormat format) {
+        MetalAutoreleasePool releasePool;
+        auto *device = static_cast<MetalDevice *>(renderDevice);
+        if (inputWidth == 0 || inputHeight == 0 || outputWidth < inputWidth || outputHeight < inputHeight ||
+            !MTLFX::SpatialScalerDescriptor::supportsDevice(device->mtl)) return false;
+        std::lock_guard lock(metalSpatialMutex());
+        auto &cached = metalSpatialState();
+        if (cached && cached->device.get() == device->mtl && cached->format == format &&
+            cached->inputWidth == inputWidth && cached->inputHeight == inputHeight &&
+            cached->outputWidth == outputWidth && cached->outputHeight == outputHeight) return true;
+        auto state = std::make_shared<MetalSpatialState>();
+        auto descriptor = NS::TransferPtr(MTLFX::SpatialScalerDescriptor::alloc()->init());
+        descriptor->setInputWidth(inputWidth);
+        descriptor->setInputHeight(inputHeight);
+        descriptor->setOutputWidth(outputWidth);
+        descriptor->setOutputHeight(outputHeight);
+        descriptor->setColorTextureFormat(mapPixelFormat(format));
+        descriptor->setOutputTextureFormat(mapPixelFormat(format));
+        descriptor->setColorProcessingMode(MTLFX::SpatialScalerColorProcessingModePerceptual);
+        state->scaler = NS::TransferPtr(descriptor->newSpatialScaler(device->mtl));
+        if (!state->scaler) {
+            reportMetalDiagnostic("MetalFX spatial scaler unavailable; keeping original renderer.", false);
+            return false;
+        }
+        state->device = NS::RetainPtr(device->mtl);
+        state->inputWidth = inputWidth; state->inputHeight = inputHeight;
+        state->outputWidth = outputWidth; state->outputHeight = outputHeight; state->format = format;
+        cached = state;
+        char message[200]{};
+        snprintf(message, sizeof(message), "MetalFX spatial prepared: %ux%u -> %ux%u, perceptual LDR",
+            inputWidth, inputHeight, outputWidth, outputHeight);
+        reportMetalDiagnostic(message, false);
+        return true;
+    }
+
+    void encodeMetalSpatialUpscaling(RenderCommandList *renderList, const RenderTexture *source, const RenderTexture *destination) {
+        MetalAutoreleasePool releasePool;
+        auto *list = static_cast<MetalCommandList *>(renderList);
+        std::shared_ptr<MetalSpatialState> state;
+        { std::lock_guard lock(metalSpatialMutex()); state = metalSpatialState(); }
+        assert(state && state->scaler);
+        auto input = NS::RetainPtr(static_cast<const ExtendedRenderTexture *>(source)->getTexture());
+        auto output = NS::RetainPtr(static_cast<const ExtendedRenderTexture *>(destination)->getTexture());
+        assert(input->width() == state->inputWidth && input->height() == state->inputHeight);
+        assert(output->width() == state->outputWidth && output->height() == state->outputHeight);
+        assert((input->usage() & state->scaler->colorTextureUsage()) == state->scaler->colorTextureUsage());
+        assert((output->usage() & state->scaler->outputTextureUsage()) == state->scaler->outputTextureUsage());
+        // These non-heap MetalTexture allocations use tracked hazards. Finish
+        // the old encoder; MetalFX tracks its directly bound input/output textures.
+        list->endOtherEncoders(EncoderType::None);
+        state->scaler->setColorTexture(input.get());
+        state->scaler->setOutputTexture(output.get());
+        state->scaler->setInputContentWidth(state->inputWidth);
+        state->scaler->setInputContentHeight(state->inputHeight);
+        state->scaler->encodeToCommandBuffer(list->mtl);
+        // Plume uses unretained command buffers. Retain every external resource
+        // and the scaler until GPU completion, independently of the next frame.
+        list->mtl->addCompletedHandler([state, input, output](MTL::CommandBuffer *) {});
+    }
