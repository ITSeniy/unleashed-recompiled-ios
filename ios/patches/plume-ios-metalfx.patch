diff --git a/plume_metal_upscaling.h b/plume_metal_upscaling.h
new file mode 100644
--- /dev/null
+++ b/plume_metal_upscaling.h
@@ -0,0 +1,17 @@
+#pragma once
+#include "plume_render_interface.h"
+namespace plume {
+// iOS-only experimental upscaling; encoding calls run on the render thread.
+bool prepareMetalSpatialUpscaling(RenderDevice *device, uint32_t inputWidth, uint32_t inputHeight,
+    uint32_t outputWidth, uint32_t outputHeight, RenderFormat format);
+void encodeMetalSpatialUpscaling(RenderCommandList *list, const RenderTexture *source, const RenderTexture *destination);
+// Pass profiling (UNLEASHED_IOS_GPU_PASS_DIAGNOSTICS=1): names the next draw's
+// pass in sampled frames; ignored in ordinary frames.
+void setMetalPassDiagnosticLabel(RenderCommandList *list, const char *label);
+bool prepareMetalTemporalUpscaling(RenderDevice *device, uint32_t inputWidth, uint32_t inputHeight,
+    uint32_t outputWidth, uint32_t outputHeight, RenderFormat format);
+void beginMetalTemporalFrame();
+bool captureMetalTemporalInputs(RenderCommandList *list, const RenderTexture *velocity, const RenderTexture *depth);
+bool encodeMetalTemporalUpscaling(RenderCommandList *list, const RenderTexture *source, const RenderTexture *destination,
+    float jitterX, float jitterY, bool resetHistory);
+}
