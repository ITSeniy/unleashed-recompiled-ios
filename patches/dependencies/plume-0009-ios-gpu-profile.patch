+    // Opt-in stage-boundary sampling of one command list per 120 lists.
+    // No extra render passes, waits, or counter buffers on ordinary launches.
+    struct MetalPassDiagnostics {
+        struct Pass {
+            uint32_t width = 0, height = 0, draws = 0, index = 0;
+            bool depth = false;
+            double vertexMs = 0.0, fragmentMs = 0.0, spanMs = 0.0;
+        };
+        static constexpr uint32_t MaxPasses = 256;
+        NS::SharedPtr<MTL::CounterSampleBuffer> samples;
+        std::vector<Pass> passes;
+        MTL::Timestamp cpuStart = 0, gpuStart = 0;
+
+        void attach(MTL::RenderPassDescriptor *descriptor, const MetalFramebuffer *framebuffer) {
+            if (passes.size() >= MaxPasses) return;
+            const uint32_t index = uint32_t(passes.size());
+            passes.push_back({framebuffer->width, framebuffer->height, 0, index,
+                framebuffer->depthAttachment.format != RenderFormat::UNKNOWN});
+            auto *attachment = descriptor->sampleBufferAttachments()->object(0);
+            attachment->setSampleBuffer(samples.get());
+            attachment->setStartOfVertexSampleIndex(index * 4);
+            attachment->setEndOfVertexSampleIndex(index * 4 + 1);
+            attachment->setStartOfFragmentSampleIndex(index * 4 + 2);
+            attachment->setEndOfFragmentSampleIndex(index * 4 + 3);
+        }
+
+        void report(MTL::CommandBuffer *buffer) {
+            if (passes.empty() || buffer->status() != MTL::CommandBufferStatusCompleted) return;
+            MetalAutoreleasePool releasePool;
+            MTL::Timestamp cpuEnd = 0, gpuEnd = 0;
+            buffer->device()->sampleTimestamps(&cpuEnd, &gpuEnd);
+            if (gpuEnd <= gpuStart || cpuEnd <= cpuStart) return;
+            // GPU ticks are not assumed to be nanoseconds: correlate both clocks.
+            const double tickToMs = double(cpuEnd - cpuStart) / double(gpuEnd - gpuStart) / 1e6;
+            const NS::Data *data = samples->resolveCounterRange(NS::Range(0, passes.size() * 4));
+            if (data == nullptr || data->length() < passes.size() * 4 * sizeof(MTL::CounterResultTimestamp)) return;
+            const auto *timestamps = static_cast<const MTL::CounterResultTimestamp *>(data->mutableBytes());
+            double vertexSum = 0.0, fragmentSum = 0.0;
+            uint32_t valid = 0;
+            for (auto &pass : passes) {
+                const auto *t = timestamps + pass.index * 4;
+                bool validSamples = true;
+                for (uint32_t i = 0; i < 4; ++i)
+                    validSamples &= t[i].timestamp != 0 && t[i].timestamp != MTL::CounterErrorValue;
+                if (!validSamples || t[1].timestamp < t[0].timestamp || t[3].timestamp < t[2].timestamp) continue;
+                pass.vertexMs = double(t[1].timestamp - t[0].timestamp) * tickToMs;
+                pass.fragmentMs = double(t[3].timestamp - t[2].timestamp) * tickToMs;
+                const auto first = std::min(t[0].timestamp, t[2].timestamp);
+                const auto last = std::max(t[1].timestamp, t[3].timestamp);
+                pass.spanMs = double(last - first) * tickToMs;
+                vertexSum += pass.vertexMs; fragmentSum += pass.fragmentMs; ++valid;
+            }
+            char message[320]{};
+            snprintf(message, sizeof(message),
+                "Metal pass profile: passes=%zu, valid=%u, gpu=%.3f ms, vertexSum=%.3f ms, fragmentSum=%.3f ms (stages may overlap)",
+                passes.size(), valid, 1000.0 * (buffer->GPUEndTime() - buffer->GPUStartTime()), vertexSum, fragmentSum);
+            reportMetalDiagnostic(message, false);
+            std::sort(passes.begin(), passes.end(), [](const Pass &a, const Pass &b) { return a.fragmentMs > b.fragmentMs; });
+            for (size_t i = 0; i < std::min(size_t(8), passes.size()); ++i) {
+                const auto &pass = passes[i];
+                snprintf(message, sizeof(message),
+                    "Metal pass cost: pass=%u, size=%ux%u, draws=%u, depth=%u, vertex=%.3f ms, fragment=%.3f ms, span=%.3f ms",
+                    pass.index, pass.width, pass.height, pass.draws, pass.depth, pass.vertexMs, pass.fragmentMs, pass.spanMs);
+                reportMetalDiagnostic(message, false);
+            }
+        }
+    };
+
+    static std::shared_ptr<MetalPassDiagnostics> createMetalPassDiagnostics(MetalDevice *device) {
+        static const bool enabled = [] {
+            const char *value = std::getenv("UNLEASHED_IOS_GPU_PASS_DIAGNOSTICS");
+            return value != nullptr && value[0] == '1';
+        }();
+        if (!enabled || !metalFrameDiagnosticsEnabled() || device->timestampCounterSet == nullptr ||
+            !device->mtl->supportsCounterSampling(MTL::CounterSamplingPointAtStageBoundary)) return {};
+        static thread_local uint32_t count = 0;
+        if (++count % 120 != 0) return {};
+        auto profile = std::make_shared<MetalPassDiagnostics>();
+        auto *descriptor = MTL::CounterSampleBufferDescriptor::alloc()->init();
+        descriptor->setCounterSet(device->timestampCounterSet);
+        descriptor->setStorageMode(MTL::StorageModeShared);
+        descriptor->setSampleCount(MetalPassDiagnostics::MaxPasses * 4);
+        NS::Error *error = nullptr;
+        profile->samples = NS::TransferPtr(device->mtl->newCounterSampleBuffer(descriptor, &error));
+        descriptor->release();
+        if (!profile->samples) {
+            reportMetalDiagnostic("Metal pass sampling unavailable: counter buffer allocation failed.", false);
+            return {};
+        }
+        device->mtl->sampleTimestamps(&profile->cpuStart, &profile->gpuStart);
+        return profile;
+    }
