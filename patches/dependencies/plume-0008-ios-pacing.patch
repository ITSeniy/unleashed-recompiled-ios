+    struct MetalEncodingDiagnostics {
+        uint32_t draws = 0, renderPasses = 0, dispatches = 0;
+    };
+    static thread_local MetalEncodingDiagnostics metalEncodingDiagnostics;
+
+    static void reportMetalGPUInterval(MTL::CommandBuffer *buffer, MetalEncodingDiagnostics encoding) {
+        // Ignore upload command lists; aggregate only lists with rendering.
+        if (encoding.draws == 0) return;
+        const double milliseconds = 1000.0 * (buffer->GPUEndTime() - buffer->GPUStartTime());
+        if (milliseconds <= 0.0) return;
+        static std::mutex mutex;
+        static uint32_t count = 0;
+        static double sum = 0.0, maximum = 0.0;
+        static uint64_t draws = 0, passes = 0, dispatches = 0;
+        char message[256]{};
+        {
+            std::lock_guard lock(mutex);
+            ++count; sum += milliseconds; maximum = std::max(maximum, milliseconds);
+            draws += encoding.draws; passes += encoding.renderPasses; dispatches += encoding.dispatches;
+            if (count < 120) return;
+            snprintf(message, sizeof(message),
+                "Metal GPU timing: n=%u, mean=%.3f ms, max=%.3f ms, draws=%.1f, renderPasses=%.1f, dispatches=%.1f",
+                count, sum / count, maximum, double(draws) / count, double(passes) / count, double(dispatches) / count);
+            count = 0; sum = maximum = 0.0; draws = passes = dispatches = 0;
+        }
+        reportMetalDiagnostic(message, false);
+    }
+
+    static void reportMetalPresentedInterval(double timestamp, double targetSeconds) {
+        static std::mutex mutex;
+        static double previous = 0.0, sum = 0.0, minimum = 1e9, maximum = 0.0;
+        static uint32_t count = 0, shortCount = 0, longCount = 0, severeCount = 0;
+        char message[352]{};
+        const double requestedMinimum = targetSeconds;
+        {
+            std::lock_guard lock(mutex);
+            if (timestamp <= previous || timestamp == 0.0)
+                return;
+            const double interval = timestamp - previous;
+            previous = timestamp;
+            if (interval > 1.0) {
+                count = shortCount = longCount = severeCount = 0;
+                sum = maximum = 0.0; minimum = 1e9;
+                return;
+            }
+            // Diagnostics target the configured cap even in the baseline run.
+            const char *target = std::getenv("UNLEASHED_IOS_DIAGNOSTIC_FPS");
+            if (target != nullptr && std::atof(target) > 0.0)
+                targetSeconds = 1.0 / std::atof(target);
+            if (targetSeconds <= 0.0)
+                targetSeconds = 1.0 / 30.0;
+            ++count; sum += interval;
+            minimum = std::min(minimum, interval); maximum = std::max(maximum, interval);
+            shortCount += interval < targetSeconds * 0.8;
+            longCount += interval > targetSeconds * 1.25;
+            severeCount += interval > targetSeconds * 1.75;
+            if (count < 120)
+                return;
+            snprintf(message, sizeof(message),
+                "Metal display timing: n=%u, mean=%.3f ms, min=%.3f ms, max=%.3f ms, short=%u, long=%u, severe=%u, target=%.3f ms, presentMin=%.3f ms",
+                count, 1000.0 * sum / count, 1000.0 * minimum, 1000.0 * maximum,
+                shortCount, longCount, severeCount, 1000.0 * targetSeconds, 1000.0 * requestedMinimum);
+            count = shortCount = longCount = severeCount = 0;
+            sum = maximum = 0.0; minimum = 1e9;
+        }
+        reportMetalDiagnostic(message, false);
     }
 
