+    // Diagnostics are opt-in and use actual display timestamps, not GPU completion.
+    static bool metalFrameDiagnosticsEnabled() {
+        static const bool enabled = [] {
+            const char *value = std::getenv("UNLEASHED_IOS_FRAME_DIAGNOSTICS");
+            return value != nullptr && value[0] == '1';
+        }();
+        return enabled;
+    }
